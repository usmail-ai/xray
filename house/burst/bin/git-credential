#!/bin/sh
# git credential helper. username is the bot login; the password is a fresh app token.
set -eu
here=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
if [ "${1:-}" != "get" ]; then
  exit 0
fi
: "${BURST_BOT_LOGIN:?}"
tok=$(node "$here/mint-cli.mjs") || exit $?
printf 'username=%s\n' "$BURST_BOT_LOGIN"
printf 'password=%s\n' "$tok"
