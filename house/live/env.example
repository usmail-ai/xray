# Names only. Never commit values. Real values live outside the repo (agent env, chmod-600 files, Railway variables).

# --- box: feed supervisor (feed/supervisor.sh) ---
GITHUB_APP_PRIVATE_KEY=        # ops-app App key; used ONLY by feed/gh-app-token-readonly.mjs (read-only mint)
LIVE_HOME=                     # base dir for releases/ and run/. default /srv/live
MESH_RUN=                      # data dir (feed/, logs/, pids). default /srv/live/run
GITHUB_APP_ID=                 # the read-only App (mint only)
GITHUB_APP_INSTALLATION_ID=    # its installation on your org
LIVE_MESH_UPSTREAM=            # repo root holding house/live-mesh/fetch_feed.py. default: this checkout
LIVE_HEALTH_URLS=            # space-separated /health URLs (status code + time only)
LIVE_MERGE_QUEUE=            # path to merge-queue.md (lab retests)
LIVE_REST_FLOOR=             # stop REST polling below this core remaining (default 1500)
LIVE_GQL_FLOOR=              # stop GraphQL below this remaining
LIVE_BACKFILL_SECONDS=       # backfill time budget per repo per pass
LIVE_RAILWAY_TARGETS=          # watchdog deploy poller: JSON [[project_name, project_id, service, [envs]]]; unset = off

# --- box: pusher (feed/push_to_host.sh) reads $MESH_RUN/.push-env (chmod 600) ---
MESH_URL=
INGEST_SECRET=

# --- Railway service live-mesh (set as Railway variables) ---
PORT=
MESH_PASSWORD=
SESSION_SECRET=
INGEST_SECRET=

# --- Railway service (Railway variables; see house/burst/DEPLOY.md) ---
SEAT_KEYS=                     # JSON {seat: sha256hex} from feed/seat_keys.sh publish (hashes only)
GITHUB_READ_TOKEN=             # fine-grained, read-only; only the collector child gets it

# --- seat helpers and external emitter ---
LIVE_URL=                      # the service URL
LIVE_KEY=                      # this seat's key (never the hash)
SEAT_KEYS_DIR=                 # box dir holding <seat>.key files (0700)

# Optional: map your fleet's GitHub logins to page seats (JSON object or path to a JSON file); unknown logins are hidden (set LIVE_SHOW_UNMAPPED=1 to show them as Others).
# LIVE_NODE_MAP={"my-builder[bot]":"Builder"}
# Counted seats for the fleet header. JSON list, or {"seats","board","fold"}, or a path. Unset keeps the example list.
# LIVE_FLEET_SEATS=["Builder","Reviewer"]
# Directory copied onto public/ at the end of deploy.sh (live-config.js, avatars). Not a Railway variable.
# LIVE_PUBLIC_OVERLAY=
# deploy.sh only. Defaults: live-board, live-mesh, /srv/live/deploy.
# LIVE_RAILWAY_PROJECT=
# LIVE_RAILWAY_SERVICE=
# MESH_APP_DEPLOY_DIR=
# seat_keys.sh. Space-separated tokens, or a JSON file (list or {"seats":[...]}).
# SEAT_KEYS_SEATS=
# SEATS_JSON=
# App /health probes for the collector. Unset means no probe.
# COLLECTOR_HEALTH_URLS=

# Holds, nudges, presence, wake, sources. Names only.
# GITHUB_HOLD_LABEL=on-hold
# NO_NUDGE_REPOS=
# JIRA_HOLD_STATUS=On Hold
# JIRA_SITE=
# JIRA_EMAIL=
# JIRA_API_TOKEN=
# JIRA_PROJECTS=
# JIRA_EXCLUDE=
# SOURCE_ALLOWLIST=
# SEAT_PRESENCE={"builder-cloud":"builder"}
# SEAT_WEBHOOKS=
# UPSTREAM_REPO=
# UPSTREAM_PINNED=
# XRAY_OURS=
# NUDGE_L3_S=7200
# HELD_MAX_S=259200
# LIVE_SHOW_UNMAPPED=1
